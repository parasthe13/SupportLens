# Copy this file to `.env` (which is git-ignored) OR export these as real
# environment variables before running the app. Do NOT commit real keys.
#
# PowerShell:  $env:OPENAI_API_KEY = "sk-your-real-key"
# bash/zsh:    export OPENAI_API_KEY="sk-your-real-key"
#
# The app boots WITHOUT a real key (Phase 0), but ingestion (Phase 2) and
# chat (Phase 3) require a valid key because they call the model provider.

OPENAI_API_KEY=sk-your-real-key
